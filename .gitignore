# Secrets / local config — never commit credentials, keys, or passwords
.env
.env.*
!.env.example
.cdsapirc
*.key
*.pem
*.p12
*.pfx
*credentials*
*secret*
# GEE service-account JSON keys — never commit
*service-account*.json
*-gee-key*.json
*.gee.json

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data layers (bronze parquet, static .nc) — large/generated, never commit
/data/
.localdata/
*.parquet
*.nc
*.grib
*.dump

# Committed exception: the shipped grid seed IS tracked on purpose (the
# distribution artifact). seeds/ is not ignored; keep it as the sole large blob.

# Timezone shapefile build artifacts (scripts/build_tz_asset.py inputs/outputs) —
# large; regenerate from timezone-boundary-builder, never commit (GEE_TZ_ASSET is the
# shipped form, held in Earth Engine, not git).
combined-with-oceans.json
tz-oceans.zip
tz_by_offset.*

# Shapefile inputs (SoilGrids-for-DSSAT point layer and friends) — tens of MB zipped,
# ~1 GB unpacked. The zip lives under .localdata/bronze/static/ at run time; the repo
# only carries the reader (src/grid/dbf.py), never the data.
*.shp.zip
*.shp
*.dbf
*.shx
*.sbn
*.sbx
*.prj
