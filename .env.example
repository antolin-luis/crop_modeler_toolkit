# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=era5
POSTGRES_USER=era5
POSTGRES_PASSWORD=change_me

# Copernicus CDS
CDS_URL=https://cds.climate.copernicus.eu/api
CDS_KEY=your_uid:your_api_key

# On-disk data root (bronze parquet + static .nc). Container default is /data
# (the SSD mount); set to a local path for host-side runs outside Docker.
DATA_DIR=/data

# Google Earth Engine — alternative bronze backend to the CDS (see docs/gee_setup.md).
# Only needed if you run the download_bronze_gee DAG; CDS-only users can leave blank.
# GEE_PROJECT is your registered noncommercial Cloud project (convention: ee-<username>).
GEE_PROJECT=ee-yourusername
# Path to the service-account JSON key for headless/Airflow auth. KEEP OUT OF GIT — point
# this OUTSIDE the repo (e.g. /run/secrets/...). Leave blank for local user-OAuth runs.
GEE_SERVICE_ACCOUNT_FILE=
# GCS bucket + object prefix that GEE exports daily GeoTIFFs to before download.
GEE_GCS_BUCKET=
GEE_GCS_PREFIX=bronze-gee

# (future) extensible
# LLM_API_KEY=
