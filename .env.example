# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=era5
POSTGRES_USER=era5
POSTGRES_PASSWORD=change_me

# Copernicus CDS
CDS_URL=https://cds.climate.copernicus.eu/api
CDS_KEY=your_uid:your_api_key

# On-disk data root (bronze parquet + static .nc). Container default is /data
# (the SSD mount); set to a local path for host-side runs outside Docker.
DATA_DIR=/data

# (future) extensible
# LLM_API_KEY=
# GEE_SERVICE_ACCOUNT=
